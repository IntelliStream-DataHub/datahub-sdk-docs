# Where the tutorials are run. Never point this at production: the suite creates
# and deletes the entities the docs use, under the docs' own external ids.
BASE_URL=http://localhost:8081

# Authenticate as the SDK does — a static token:
# TOKEN=eyJhbGciOi...

# …or OAuth2 client credentials:
# CLIENT_ID=
# CLIENT_SECRET=
# TOKEN_URI=

# …or, for a local stack, a command that prints a token as its last line.
# Its result is cached for a few minutes so a full run mints once.
# DOCTEST_TOKEN_CMD=node ../datahub-platform/.claude/dev/get-token.js
